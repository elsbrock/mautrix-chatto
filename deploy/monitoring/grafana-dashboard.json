        }
      }
    },
    {
      "id": 17,
      "title": "Memory",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=~\"$job\"}",
          "legendFormat": "rss",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "go_memstats_heap_inuse_bytes{job=~\"$job\"}",
          "legendFormat": "heap in use",
          "datasource": {
            "type": "prometheus",
