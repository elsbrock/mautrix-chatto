          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "title": "RPC errors by method and code",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (procedure, code) (rate(mautrix_chatto_rpc_errors_total{job=~\"$job\",server=~\"$server\"}[$__rate_interval]))",
          "legendFormat": "{{procedure}} {{code}}",
          "datasource": {
